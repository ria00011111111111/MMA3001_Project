
import json
import zipfile
from pathlib import Path

import pandas as pd


# --------------------------------------------------
# 1. Paths and settings
# --------------------------------------------------

ROOT = Path(__file__).resolve().parents[1]

ZIP_PATH = ROOT / "data" / "5EnvSensor_MayToDec2024_180kRows.zip"

OUTPUT_DIR = ROOT / "outputs" / "diagnostics"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

USABLE_SENSOR_IDS = [
    "6012002000326",
    "6012002000869",
]

VARIABLES_TO_CHECK = [
    "Carbon dioxide",
    "Temperature",
    "Humidity",
    "Pressure",
    "Battery",
]


# --------------------------------------------------
# 2. Load the original dataset
# --------------------------------------------------

with zipfile.ZipFile(ZIP_PATH, "r") as archive:
    csv_files = [
        name for name in archive.namelist()
        if name.lower().endswith(".csv")
    ]

    if not csv_files:
        raise FileNotFoundError("No CSV found inside the ZIP file.")

    with archive.open(csv_files[0]) as file:
        raw = pd.read_csv(file, dtype={"sensorid": str})

print("Original rows:", len(raw))


# --------------------------------------------------
# 3. Extract measurements from jsondata
# --------------------------------------------------

def extract_measurements(json_text):
    result = {}

    if pd.isna(json_text):
        return result

    try:
        measurements = json.loads(json_text)
    except (json.JSONDecodeError, TypeError):
        return result

    if not isinstance(measurements, list):
        return result

    for measurement in measurements:
        variable_info = measurement.get("variable", {})
        name = variable_info.get("name")
        values = measurement.get("values", [])

        if not name or not values:
            continue

        # Match the extraction method used in earlier scripts.
        first_value = values[0]

        result[name] = first_value.get("value")
        result[f"{name}_time"] = first_value.get("time")

    return result


expanded = raw["jsondata"].apply(
    extract_measurements
).apply(pd.Series)

df = pd.concat(
    [
        raw[["id", "sensorid", "createdate", "processdate"]],
        expanded,
    ],
    axis=1,
)

# Only investigate the two promising sensors.
df["sensorid"] = df["sensorid"].astype(str)
df = df[df["sensorid"].isin(USABLE_SENSOR_IDS)].copy()

print("Rows for selected sensors:", len(df))


# --------------------------------------------------
# 4. Parse timestamps
# --------------------------------------------------

df["measurement_timestamp"] = pd.to_datetime(
    pd.to_numeric(
        df.get("Carbon dioxide_time"),
        errors="coerce",
    ),
    unit="s",
    errors="coerce",
    utc=True,
)

df["createdate_parsed"] = pd.to_datetime(
    df["createdate"],
    errors="coerce",
    utc=True,
)

df["processdate_parsed"] = pd.to_datetime(
    df["processdate"],
    errors="coerce",
    utc=True,
)

df["measurement_vs_createdate_minutes"] = (
    df["measurement_timestamp"] - df["createdate_parsed"]
).dt.total_seconds() / 60

df["measurement_vs_processdate_minutes"] = (
    df["measurement_timestamp"] - df["processdate_parsed"]
).dt.total_seconds() / 60

for variable in VARIABLES_TO_CHECK:
    if variable in df.columns:
        df[variable] = pd.to_numeric(
            df[variable],
            errors="coerce",
        )


# --------------------------------------------------
# 5. Compare timestamps with record dates
# --------------------------------------------------

date_results = []

for sensor_id, group in df.groupby("sensorid"):
    offsets = group["measurement_vs_createdate_minutes"].dropna()
    process_offsets = group[
        "measurement_vs_processdate_minutes"
    ].dropna()

    date_results.append({
        "sensorid": sensor_id,
        "rows": len(group),
        "missing_measurement_timestamps": (
            group["measurement_timestamp"].isna().sum()
        ),
        "unique_measurement_timestamps": (
            group["measurement_timestamp"].nunique()
        ),
        "measurement_start": (
            group["measurement_timestamp"].min()
        ),
        "measurement_end": (
            group["measurement_timestamp"].max()
        ),
        "createdate_start": group["createdate_parsed"].min(),
        "createdate_end": group["createdate_parsed"].max(),
        "median_offset_minutes": offsets.median(),
        "median_absolute_offset_minutes": offsets.abs().median(),
        "offsets_over_1_hour": int((offsets.abs() > 60).sum()),
        "offsets_over_24_hours": int((offsets.abs() > 1440).sum()),
        "median_processdate_offset_minutes": process_offsets.median(),
    })

date_summary = pd.DataFrame(date_results)

date_summary.to_csv(
    OUTPUT_DIR / "usable_sensor_date_comparison.csv",
    index=False,
)


# --------------------------------------------------
# 6. Check conflicting readings at repeated timestamps
# --------------------------------------------------

conflict_results = []

for sensor_id, group in df.groupby("sensorid"):
    valid = group.dropna(subset=["measurement_timestamp"])

    for variable in VARIABLES_TO_CHECK:
        if variable not in valid.columns:
            continue

        # Count distinct values recorded for each timestamp.
        counts = (
            valid.dropna(subset=[variable])
            .groupby("measurement_timestamp")[variable]
            .nunique()
        )

        conflict_results.append({
            "sensorid": sensor_id,
            "variable": variable,
            "timestamps_with_readings": len(counts),
            "timestamps_with_multiple_different_values": int(
                (counts > 1).sum()
            ),
            "maximum_distinct_values_at_one_timestamp": (
                counts.max() if len(counts) else 0
            ),
        })

conflicts = pd.DataFrame(conflict_results)

conflicts.to_csv(
    OUTPUT_DIR / "usable_sensor_timestamp_conflicts.csv",
    index=False,
)


# --------------------------------------------------
# 7. Find large gaps in measurement timestamps
# --------------------------------------------------

gap_results = []
gap_examples = []

for sensor_id, group in df.groupby("sensorid"):
    times = (
        group["measurement_timestamp"]
        .dropna()
        .drop_duplicates()
        .sort_values()
        .reset_index(drop=True)
    )

    gaps = times.diff().dt.total_seconds().div(60)

    for index in range(1, len(times)):
        gap_minutes = gaps.iloc[index]

        if pd.notna(gap_minutes) and gap_minutes > 60:
            gap_examples.append({
                "sensorid": sensor_id,
                "previous_timestamp": times.iloc[index - 1],
                "next_timestamp": times.iloc[index],
                "gap_minutes": gap_minutes,
                "gap_hours": gap_minutes / 60,
            })

    valid_gaps = gaps.dropna()

    gap_results.append({
        "sensorid": sensor_id,
        "unique_timestamps": len(times),
        "median_gap_minutes": valid_gaps.median(),
        "maximum_gap_minutes": valid_gaps.max(),
        "gaps_over_30_minutes": int((valid_gaps > 30).sum()),
        "gaps_over_60_minutes": int((valid_gaps > 60).sum()),
        "gaps_over_24_hours": int((valid_gaps > 1440).sum()),
    })

gap_summary = pd.DataFrame(gap_results)
gap_examples_df = pd.DataFrame(gap_examples)

gap_summary.to_csv(
    OUTPUT_DIR / "usable_sensor_gap_summary.csv",
    index=False,
)

gap_examples_df.to_csv(
    OUTPUT_DIR / "usable_sensor_large_gaps.csv",
    index=False,
)


# --------------------------------------------------
# 8. Summarise reading variation
# --------------------------------------------------

variation_results = []

for sensor_id, group in df.groupby("sensorid"):
    for variable in VARIABLES_TO_CHECK:
        if variable not in group.columns:
            continue

        values = group[variable].dropna()

        variation_results.append({
            "sensorid": sensor_id,
            "variable": variable,
            "valid_readings": len(values),
            "unique_readings": values.nunique(),
            "minimum": values.min() if len(values) else None,
            "maximum": values.max() if len(values) else None,
            "standard_deviation": (
                values.std() if len(values) > 1 else None
            ),
        })

variation = pd.DataFrame(variation_results)

variation.to_csv(
    OUTPUT_DIR / "usable_sensor_reading_variation.csv",
    index=False,
)


# --------------------------------------------------
# 9. Save selected records for manual inspection
# --------------------------------------------------

sample_columns = [
    "id",
    "sensorid",
    "createdate",
    "processdate",
    "measurement_timestamp",
    "measurement_vs_createdate_minutes",
    "measurement_vs_processdate_minutes",
] + [
    variable for variable in VARIABLES_TO_CHECK
    if variable in df.columns
]

df[sample_columns].groupby("sensorid", group_keys=False).head(20).to_csv(
    OUTPUT_DIR / "usable_sensor_sample_records.csv",
    index=False,
)


# --------------------------------------------------
# 10. Print the important results
# --------------------------------------------------

print("\n=== DATE COMPARISON ===")
print(date_summary.to_string(index=False))

print("\n=== TIMESTAMP CONFLICTS ===")
print(conflicts.to_string(index=False))

print("\n=== GAP SUMMARY ===")
print(gap_summary.to_string(index=False))

print("\n=== READING VARIATION ===")
print(variation.to_string(index=False))

print("\n=== LARGE TIMESTAMP GAPS ===")
if gap_examples_df.empty:
    print("No gaps greater than 60 minutes found.")
else:
    print(
        gap_examples_df.sort_values(
            "gap_minutes",
            ascending=False,
        ).head(30).to_string(index=False)
    )

print("\nDiagnostic files saved in:")
print(OUTPUT_DIR)
