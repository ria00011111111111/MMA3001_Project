
import json
import zipfile
from pathlib import Path

import pandas as pd


ROOT = Path(__file__).resolve().parents[1]
ZIP_PATH = ROOT / "data" / "5EnvSensor_MayToDec2024_180kRows.zip"
OUTPUT_DIR = ROOT / "outputs" / "diagnostics"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

TARGET_SENSORS = ["6012002000326", "6012002000869"]
MAX_OFFSET_MINUTES = 60


def extract_measurements(json_text):
    result = {}

    if pd.isna(json_text):
        return result

    try:
        measurements = json.loads(json_text)
    except (json.JSONDecodeError, TypeError):
        return result

    if not isinstance(measurements, list):
        return result

    for measurement in measurements:
        name = measurement.get("variable", {}).get("name")
        values = measurement.get("values", [])

        if name and values:
            result[name] = values[0].get("value")
            result[f"{name}_time"] = values[0].get("time")

    return result


# Load original records.
with zipfile.ZipFile(ZIP_PATH, "r") as archive:
    csv_file = next(
        name for name in archive.namelist()
        if name.lower().endswith(".csv")
    )

    with archive.open(csv_file) as file:
        raw = pd.read_csv(file, dtype={"sensorid": str})

expanded = raw["jsondata"].apply(
    extract_measurements
).apply(pd.Series)

df = pd.concat(
    [raw[["id", "sensorid", "createdate"]], expanded],
    axis=1,
)

df = df[df["sensorid"].isin(TARGET_SENSORS)].copy()

df["measurement_timestamp"] = pd.to_datetime(
    pd.to_numeric(df.get("Carbon dioxide_time"), errors="coerce"),
    unit="s",
    errors="coerce",
    utc=True,
)

df["createdate_parsed"] = pd.to_datetime(
    df["createdate"], errors="coerce", utc=True
)

df["offset_minutes"] = (
    df["measurement_timestamp"] - df["createdate_parsed"]
).dt.total_seconds() / 60

df["absolute_offset_minutes"] = df["offset_minutes"].abs()

df["timestamp_status"] = "within_60_minutes"
df.loc[
    df["measurement_timestamp"].isna(),
    "timestamp_status"
] = "missing_measurement_timestamp"

df.loc[
    df["absolute_offset_minutes"] > MAX_OFFSET_MINUTES,
    "timestamp_status"
] = "over_60_minutes"


# Summarise record-creation periods and timestamp reliability.
df["creation_day"] = df["createdate_parsed"].dt.floor("D")

daily = (
    df.groupby(["sensorid", "creation_day", "timestamp_status"])
    .size()
    .unstack(fill_value=0)
    .reset_index()
)

daily.to_csv(
    OUTPUT_DIR / "timestamp_reliability_by_day.csv",
    index=False,
)

summary = (
    df.groupby(["sensorid", "timestamp_status"])
    .agg(
        records=("id", "size"),
        first_created=("createdate_parsed", "min"),
        last_created=("createdate_parsed", "max"),
        first_measurement=("measurement_timestamp", "min"),
        last_measurement=("measurement_timestamp", "max"),
    )
    .reset_index()
)

summary.to_csv(
    OUTPUT_DIR / "timestamp_reliability_summary.csv",
    index=False,
)


# Inspect records around transitions between reliable-looking
# and badly mismatched timestamps.
df = df.sort_values(["sensorid", "createdate_parsed"])

df["previous_status"] = (
    df.groupby("sensorid")["timestamp_status"].shift(1)
)

transitions = df[
    df["timestamp_status"] != df["previous_status"]
].copy()

columns = [
    "id",
    "sensorid",
    "createdate",
    "measurement_timestamp",
    "offset_minutes",
    "timestamp_status",
    "Carbon dioxide",
    "Temperature",
    "Humidity",
]

columns = [column for column in columns if column in df.columns]

transitions[columns].to_csv(
    OUTPUT_DIR / "timestamp_reliability_transitions.csv",
    index=False,
)

print("\n=== RELIABILITY SUMMARY ===")
print(summary.to_string(index=False))

print("\n=== DAILY RELIABILITY COUNTS ===")
print(daily.tail(40).to_string(index=False))

print("\n=== STATUS TRANSITIONS ===")
print(transitions[columns].to_string(index=False))

print("\nSaved diagnostics to:", OUTPUT_DIR)
