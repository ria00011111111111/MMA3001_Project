
import json
import zipfile
from pathlib import Path

import pandas as pd


ROOT = Path(__file__).resolve().parents[1]
ZIP_PATH = ROOT / "data" / "5EnvSensor_MayToDec2024_180kRows.zip"
OUTPUT_DIR = ROOT / "outputs" / "diagnostics"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

TARGET_SENSORS = ["6012002000326", "6012002000869"]


def extract_measurements(json_text):
    result = {}

    if pd.isna(json_text):
        return result

    try:
        measurements = json.loads(json_text)
    except (json.JSONDecodeError, TypeError):
        return result

    if not isinstance(measurements, list):
        return result

    for measurement in measurements:
        name = measurement.get("variable", {}).get("name")
        values = measurement.get("values", [])

        if name and values:
            result[name] = values[0].get("value")
            result[f"{name}_time"] = values[0].get("time")

    return result


# Load the original records.
with zipfile.ZipFile(ZIP_PATH, "r") as archive:
    csv_file = next(
        name for name in archive.namelist()
        if name.lower().endswith(".csv")
    )

    with archive.open(csv_file) as file:
        raw = pd.read_csv(file, dtype={"sensorid": str})

expanded = raw["jsondata"].apply(
    extract_measurements
).apply(pd.Series)

df = pd.concat(
    [raw[["id", "sensorid", "createdate", "processdate"]], expanded],
    axis=1,
)

df = df[df["sensorid"].isin(TARGET_SENSORS)].copy()

df["measurement_timestamp"] = pd.to_datetime(
    pd.to_numeric(df.get("Carbon dioxide_time"), errors="coerce"),
    unit="s",
    errors="coerce",
    utc=True,
)

df["createdate_parsed"] = pd.to_datetime(
    df["createdate"], errors="coerce", utc=True
)

df["processdate_parsed"] = pd.to_datetime(
    df["processdate"], errors="coerce", utc=True
)

df["offset_minutes"] = (
    df["measurement_timestamp"] - df["createdate_parsed"]
).dt.total_seconds() / 60

for column in [
    "Carbon dioxide", "Temperature", "Humidity", "Pressure", "Battery"
]:
    if column in df.columns:
        df[column] = pd.to_numeric(df[column], errors="coerce")


# Show records with the largest absolute disagreement between
# measurement time and record creation time.
df["absolute_offset_minutes"] = df["offset_minutes"].abs()

largest_offsets = df.sort_values(
    "absolute_offset_minutes", ascending=False
).groupby("sensorid", group_keys=False).head(15)

# Show samples from the start and end of each sensor's measurement timeline.
timeline_samples = []

for sensor_id, group in df.groupby("sensorid"):
    valid = group.dropna(subset=["measurement_timestamp"]).sort_values(
        "measurement_timestamp"
    )

    timeline_samples.append(valid.head(10))
    timeline_samples.append(valid.tail(10))

timeline_samples = pd.concat(timeline_samples).drop_duplicates()

# Save compact files for inspection.
columns = [
    "id",
    "sensorid",
    "createdate",
    "processdate",
    "measurement_timestamp",
    "offset_minutes",
    "Carbon dioxide",
    "Temperature",
    "Humidity",
    "Pressure",
    "Battery",
]

columns = [column for column in columns if column in df.columns]

largest_offsets[columns].to_csv(
    OUTPUT_DIR / "largest_timestamp_offset_examples.csv",
    index=False,
)

timeline_samples[columns].to_csv(
    OUTPUT_DIR / "measurement_timeline_endpoints.csv",
    index=False,
)

print("\n=== LARGEST TIMESTAMP OFFSETS ===")
print(
    largest_offsets[columns].to_string(index=False)
)

print("\n=== TIMELINE ENDPOINTS ===")
print(
    timeline_samples[columns].sort_values(
        ["sensorid", "measurement_timestamp"]
    ).to_string(index=False)
)

print("\nSaved files to:", OUTPUT_DIR)
