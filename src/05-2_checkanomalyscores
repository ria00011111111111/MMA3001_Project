
import pandas as pd
from pathlib import Path

path = Path("outputs/modeldevelopment/model_ready_sensor_data.csv")
df = pd.read_csv(path)

print("\nOVERALL ANOMALY SUMMARY")
print("Total rows:", len(df))
print("\nFlag counts:")
print(df["environmental_anomaly_flag"].value_counts(dropna=False))

print("\nANOMALY SCORE SUMMARY")
print(
    df.groupby("environmental_anomaly_flag")[
        "environmental_anomaly_score"
    ].agg(["count", "mean", "std", "min", "median", "max"]).round(4)
)

print("\nCO2 SUMMARY BY ANOMALY FLAG")
print(
    df.groupby("environmental_anomaly_flag")["co2"]
    .agg(["count", "mean", "std", "min", "median", "max"])
    .round(2)
)

print("\nANOMALY RATE BY SENSOR")
print(
    df.groupby("sensorid")
    .agg(
        total_rows=("environmental_anomaly_flag", "size"),
        anomalies=("environmental_anomaly_flag", "sum"),
        mean_co2=("co2", "mean"),
    )
    .assign(
        anomaly_percent=lambda x: (
            100 * x["anomalies"] / x["total_rows"]
        )
    )
    .round(2)
)

print("\nHIGHEST CO2 FLAGGED READINGS")
columns = [
    "sensorid",
    "measurement_time_melbourne",
    "co2",
    "temperature",
    "humidity",
    "pressure",
    "environmental_anomaly_score",
]

print(
    df.loc[df["environmental_anomaly_flag"] == True, columns]
    .sort_values("co2", ascending=False)
    .head(15)
    .to_string(index=False)
)